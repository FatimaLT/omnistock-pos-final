# OmniStock POS - Configuration Template
# Copy this file to .env and configure with your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
OMNISTOCK_DB_HOST=localhost
OMNISTOCK_DB_PORT=3306
OMNISTOCK_DB_NAME=omnistock_db
OMNISTOCK_DB_USER=root
OMNISTOCK_DB_PASSWORD=

# =============================================================================
# INITIAL ADMIN USER (Auto-seeded on first database initialization)
# =============================================================================
OMNISTOCK_INITIAL_ADMIN_USERNAME=admin@omnistock.com
OMNISTOCK_INITIAL_ADMIN_PASSWORD=
OMNISTOCK_INITIAL_ADMIN_NAME=Administrador

# =============================================================================
# DEMO SELLER USER (Optional - Set to '1' to enable auto-seed)
# =============================================================================
OMNISTOCK_SEED_DEMO_SELLER=0
OMNISTOCK_DEFAULT_SELLER_PASSWORD=

# =============================================================================
# PUBLIC DEMO LOGIN PANEL (Optional - dedicated demo users only)
# =============================================================================
OMNISTOCK_PUBLIC_DEMO_ENABLED=0
OMNISTOCK_PUBLIC_DEMO_ADMIN_USERNAME=
OMNISTOCK_PUBLIC_DEMO_ADMIN_PASSWORD=
OMNISTOCK_PUBLIC_DEMO_SELLER_USERNAME=
OMNISTOCK_PUBLIC_DEMO_SELLER_PASSWORD=

# =============================================================================
# TRANSFER PAYMENT METHOD CONFIGURATION
# =============================================================================
# Fictional portfolio/demo details. Replace them with verified data before use.
# CLABE must be exactly 18 numeric digits.
OMNISTOCK_TRANSFER_BANK="STP (Sistema de Transferencias y Pagos) / Banco SA"
OMNISTOCK_TRANSFER_CLABE=646180157000000019
OMNISTOCK_TRANSFER_HOLDER="OmniStock & POS Demo"
OMNISTOCK_TRANSFER_CONCEPT="Venta de Mostrador - Ticket #00128"
OMNISTOCK_TRANSFER_REFERENCE=1234567
OMNISTOCK_TRANSFER_AUTHORIZATION=AUT-889921

# Utilidades locales de demostración/prueba. Mantener desactivadas en producción.
OMNISTOCK_ENABLE_LOCAL_DEMO_SESSION=0
OMNISTOCK_ENABLE_TEST_SALE=0

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_ENV=production
APP_DEBUG=false
APP_BASE_PATH=/omnistock-pos
APP_TIMEZONE=America/Mexico_City

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Session timeout in minutes (default: 480 = 8 hours)
SESSION_TIMEOUT=480

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=warning
LOG_FILE=/var/log/omnistock/application.log
